AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

# Patient notifications (Amazon SES). Leave NOTIFY_TO blank to preview without sending.
# SES sandbox: both addresses must be verified in SES first.
SES_FROM=
NOTIFY_TO=
# Gmail and Outlook deliver you+irene@gmail.com to you@gmail.com. Set false if yours does not.
NOTIFY_PLUS_TAGS=true
# Optional Bedrock guardrail applied to message drafts
GUARDRAIL_ID=
GUARDRAIL_VERSION=
