{
  "name": "relay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"node --env-file=.env server/index.js\" \"vite --config client/vite.config.js\"",
    "start": "node --env-file=.env server/index.js",
    "check": "node server/safety.js",
    "build": "vite build --config client/vite.config.js",
    "check:notify": "node server/notify.check.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.901.0",
    "@aws-sdk/client-bedrock-runtime": "^3.901.0",
    "@aws-sdk/client-polly": "^3.901.0",
    "@aws-sdk/client-sesv2": "^3.901.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "vite": "^7.1.2"
  }
}
